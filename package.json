{
  "name": "stomata-hour",
  "private": true,
  "version": "1.0.0",
  "description": "Stomata Hour — leaf pores open and close with light, CO₂, and drought cues",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./docs/css/stomata-hour.css --minify",
    "build:js": "node scripts/build-js.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./src/input.css -o ./docs/css/stomata-hour.css --watch",
    "watch:js": "node scripts/watch-js.js",
    "watch": "concurrently -k -n css,js -c green,cyan \"npm:watch:css\" \"npm:watch:js\"",
    "start": "npm run watch"
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
